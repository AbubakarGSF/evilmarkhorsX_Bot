# Telegram
BOT_TOKEN=123456:ABC
# ADMIN_IDS zaroori hai - bot start nahi hoga agar ye set nahi hai.
ADMIN_IDS=
WEBSITE=https://evilmarkhors.me, https://evilmarkhors.tech
CREDIT=Config by Evil Markhors

# behaviour
LIVE=1
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
# MAX_FILES = accounts per zip (default 15000). Increase for 15k+ account batches.
MAX_FILES=15000
TWEET_LIMIT=265
POST_MIN=45
POST_MAX=110
THREAD_GAP_MIN=4
THREAD_GAP_MAX=9
JOB_REAP_MIN=30
# ZIP_UPLOAD_MAX = max output zip size for Telegram (default 60MB).
ZIP_UPLOAD_MAX=62914560
# zip bomb guard: per-entry aur total uncompressed size
ZIP_MAX_FILE=16777216
ZIP_MAX_TOTAL=268435456
# pending login/email code kitni der valid rahe (minutes)
PEND_TTL_MIN=180
# /camp start ke baad kitni der zip ka intezar (seconds)
CAMP_STAGE_SEC=21600
STORE_PATH=users.json
MEDIA_WAIT_MAX=300

# Supabase (service_role key: RLS bypass karti hai - root password ki tarah treat karein)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
DB_TABLE=accounts
REVERIFY_HOURS=24
REVERIFY_BATCH=400
REVERIFY_CONC=4
DEAD_AFTER=2

# proxies (sirf X traffic in par jaata hai; Telegram + Supabase direct)
# supported: http://, https://, socks5://, socks5h://  (vless/ss/trojan nahi)
# ek line/comma mein jitne chahe: http://u:p@1.2.3.4:8080,socks5://5.6.7.8:1080
# provider panel (host:port:user:pass) bhi chalta hai - type PROXY_TYPE se aata hai:
#   45.144.31.82:5000:LzaXXXX:CWNXXXX        + PROXY_TYPE=socks5
#   socks5|45.144.31.82:5000:LzaXXXX:CWNXXXX (inline marker, PROXY_TYPE bypass)
#   socks5://LzaXXXX:CWNXXXX@45.144.31.82:5000
# IPv6: socks5|[2001:db8::1]:5000:LzaXXXX:CWNXXXX  (brackets optional)
PROXIES=
# scheme-less lines ke liye default: http | https | socks5 | socks5h
PROXY_TYPE=http
# ya volume pe file: ek line = ek proxy, # comment
PROXY_FILE=
# rotate = round robin | random
PROXY_MODE=rotate
# Proxy health: baar-baar fail hone par proxy ko N minute ke liye ban karo.
PROXY_BAN_THRESHOLD=5
PROXY_BAN_MIN=30
PROXY_TEST_URL=https://api.x.com/1.1/account/verify_credentials.json
# deploy ke baad admins ko netcheck summary (0 = off)
NETCHECK_ON_START=1
# Health check server port (0 = disabled). Railway / load balancer ke liye.
HEALTH_CHECK_PORT=0
HEALTH_CHECK_HOST=0.0.0.0

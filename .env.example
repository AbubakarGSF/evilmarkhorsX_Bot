# Telegram
BOT_TOKEN=123456:ABC
ADMIN_IDS=7028523300,6120166351
WEBSITE=https://evilmarkhors.me, https://evilmarkhors.tech
CREDIT=Config by Evil Markhors

# behaviour
LIVE=1
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
MAX_FILES=5000
TWEET_LIMIT=265
POST_MIN=45
POST_MAX=110
THREAD_GAP_MIN=4
THREAD_GAP_MAX=9
JOB_REAP_MIN=30
ZIP_UPLOAD_MAX=47185920
# zip bomb guard: per-entry aur total uncompressed size
ZIP_MAX_FILE=16777216
ZIP_MAX_TOTAL=268435456
# pending login/email code kitni der valid rahe (minutes)
PEND_TTL_MIN=180
# /camp start ke baad kitni der zip ka intezar (seconds)
CAMP_STAGE_SEC=21600
STORE_PATH=users.json
MEDIA_WAIT_MAX=300

# Supabase (service_role key: RLS is on with no policies)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
DB_TABLE=accounts
REVERIFY_HOURS=24
REVERIFY_BATCH=400
REVERIFY_CONC=4
DEAD_AFTER=2

# proxies (sirf X traffic in par jaata hai; Telegram + Supabase direct)
# supported: http://, https://, socks5://  (vless:// / ss:// / trojan:// nahi)
# ek line/comma mein jitne chahe: http://u:p@1.2.3.4:8080,socks5://5.6.7.8:1080
PROXIES=
# ya volume pe file: ek line = ek proxy, # comment
PROXY_FILE=
# rotate = round robin | random
PROXY_MODE=rotate
PROXY_TEST_URL=https://api.x.com/1.1/help.json

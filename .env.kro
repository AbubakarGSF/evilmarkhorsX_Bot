# Evil Markhors Bot - KRO Proxies Configuration
# Copy this to .env and fill in your values

# ==================== BOT CONFIG ====================
BOT_TOKEN=123456:ABC        # Your Telegram Bot Token
ADMIN_IDS=7028523300,6120166351  # Your Telegram User IDs (comma-separated)

# ==================== X API CONFIG ====================
BEARER_TOKEN=your_bearer_token_here  # X API Bearer Token (REQUIRED)

WEBSITE=https://evilmarkhors.me
CREDIT=Config by Evil Markhors

# ==================== BEHAVIOUR ====================
LIVE=1
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
MAX_FILES=15000
TWEET_LIMIT=265
POST_MIN=45
POST_MAX=110
THREAD_GAP_MIN=4
THREAD_GAP_MAX=9
JOB_REAP_MIN=30
ZIP_UPLOAD_MAX=62914560
ZIP_MAX_FILE=16777216
ZIP_MAX_TOTAL=268435456
PEND_TTL_MIN=180
CAMP_STAGE_SEC=21600
STORE_PATH=users.json
MEDIA_WAIT_MAX=300

# ==================== SUPABASE CONFIG ====================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
DB_TABLE=accounts
REVERIFY_HOURS=24
REVERIFY_BATCH=400
REVERIFY_CONC=4
DEAD_AFTER=2

# ==================== PROXY CONFIG ====================
# Format: socks5|host:port:user:pass (one per line)
# Or: http://u:p@host:port,socks5://host:port (comma separated in PROXIES)

# Option A: Use PROXY_FILE (recommended for many proxies)
PROXIES=              # Leave empty if using PROXY_FILE
PROXY_FILE=kro_proxies.txt  # Path relative to bot directory
PROXY_TYPE=socks5     # Type: http, https, socks5, or socks5h
PROXY_MODE=rotate     # rotate (round robin) or random
PROXY_TEST_URL=https://api.x.com/1.1/account/verify_credentials.json

# Option B: Use inline PROXIES (comma-separated)
# PROXIES=socks5|gw.proxi.st:9999:nrta23q1-cc-US:mo1KpFnV,socks5|gw.proxi.st:9999:nrta23q1-cc-KR:mo1KpFnV

# ==================== NETWORK ====================
NETCHECK_ON_START=1
HEALTH_CHECK_PORT=0
HEALTH_CHECK_HOST=0.0.0.0
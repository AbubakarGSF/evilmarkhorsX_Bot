# Evil Markhors Bot - KRO Proxies Configuration
# Copy this to .env and fill in your values

# ==================== BOT CONFIG ====================
BOT_TOKEN=123456:ABC        # Your Telegram Bot Token
ADMIN_IDS=7028523300,6120166351  # Your Telegram User IDs (comma-separated)

# ==================== X API CONFIG ====================
BEARER_TOKEN=your_bearer_token_here  # X API Bearer Token (REQUIRED)

WEBSITE=https://evilmarkhors.me
CREDIT=Config by Evil Markhors

# ==================== BEHAVIOUR ====================
LIVE=1
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
MAX_FILES=15000
TWEET_LIMIT=265
POST_MIN=45
POST_MAX=110
THREAD_GAP_MIN=4
THREAD_GAP_MAX=9
JOB_REAP_MIN=30
ZIP_UPLOAD_MAX=62914560
ZIP_MAX_FILE=16777216
ZIP_MAX_TOTAL=268435456
PEND_TTL_MIN=180
CAMP_STAGE_SEC=21600
STORE_PATH=users.json
MEDIA_WAIT_MAX=300

# ==================== SUPABASE CONFIG ====================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
DB_TABLE=accounts
REVERIFY_HOURS=24
REVERIFY_BATCH=400
REVERIFY_CONC=4
DEAD_AFTER=2

# ==================== PROXY CONFIG ====================
# ⚠️ PROXIES, PROXY_FILE, PROXY_TYPE, PROXY_MODE REMOVED for direct connection
# Bot will run without proxies - X traffic goes direct.
# Remove these from Railway Dashboard Variables too:
#   PROXIES
#   PROXY_FILE
#   PROXY_TYPE
#   PROXY_MODE

# Direct connection only - no proxy vars needed:
# Just set: BOT_TOKEN, ADMIN_IDS, BEARER_TOKEN, SUPABASE_URL, SUPABASE_KEY

# If you need proxies later, add them back to Railway Variables:
#   PROXIES=socks5|host:port:user:pass
#   PROXY_FILE=/path/to/proxies.txt
#   PROXY_TYPE=socks5
#   PROXY_MODE=rotate

# ==================== NETWORK ====================
NETCHECK_ON_START=1
HEALTH_CHECK_PORT=0
HEALTH_CHECK_HOST=0.0.0.0